# Fit analysis provider: "mock" (offline) or "openai"
AI_PROVIDER=mock

# Required for OpenAI fit analysis OR job brief generation.
# Brief generation calls OpenAI even when AI_PROVIDER=mock.
OPENAI_API_KEY=

# Model for both OpenAI calls. Cost depends on token usage and current pricing.
OPENAI_MODEL=gpt-4o-mini

# SQLite database file (created automatically on first run)
DATABASE_URL=sqlite:///./roleradar.db
